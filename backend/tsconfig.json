{
    "compilerOptions": {
        "target": "ES2022",
        "module": "CommonJS",
        "moduleResolution": "node",
        "ignoreDeprecations": "5.0",
        "paths": {
            "@config/*": [
                "./src/config/*"
            ],
            "@routes/*": [
                "./src/routes/*"
            ],
            "@features/*": [
                "./src/features/*"
            ],
            "@middleware/*": [
                "./src/middleware/*"
            ],
            "@indexer": [
                "./src/indexer/index.ts"
            ],
            "@indexer/*": [
                "./src/indexer/*"
            ],
            "@repositories/*": [
                "./src/repositories/*"
            ],
            "@utils": [
                "./src/utils/index.ts"
            ],
            "@typings/*": [
                "./src/types/*"
            ],
            "@generated/*": [
                "./src/generated/*"
            ],
            "@indexing/*": [
                "./indexing/*"
            ],
            "@graphql": [
                "./src/graphql/index.ts"
            ]
        },
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "allowJs": true,
        "outDir": "./dist",
        // rootDir spans src/ (the app) and indexing/ (the per-chain roster
        // indexers), so the backend root is the common root → emits dist/src/...
        // and dist/indexing/... (entry: dist/src/server.js).
        "rootDir": "./",
        "strict": true,
        "noImplicitAny": true,
        "strictNullChecks": true,
        "strictFunctionTypes": true,
        "noImplicitReturns": true,
        "noFallthroughCasesInSwitch": true,
        "noUncheckedIndexedAccess": true,
        "noImplicitOverride": true,
        "exactOptionalPropertyTypes": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "noEmit": false
    },
    "include": [
        "src/**/*",
        "indexing/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist",
        // The subgraph deploy project — AssemblyScript mappings built by
        // graph-cli, not part of the backend's TypeScript program.
        "indexing/evm/subgraph"
    ]
}