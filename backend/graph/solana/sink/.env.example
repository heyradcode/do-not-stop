# Copy to sink/.env and fill in. Used by docker-compose.yml + apply-metadata.sh.

# Postgres the sink writes to and Hasura reads from. Same instance as the
# backend DATABASE_URL — Hasura connects to the whole DB; the pet table lives
# in the `solana` schema. (Hasura uses the postgresql:// scheme.)
HASURA_GRAPHQL_DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:5432/cryptopets

# Admin secret protecting the Hasura endpoint/console. The backend sends this
# as x-hasura-admin-secret (HASURA_ADMIN_SECRET in backend/.env).
HASURA_GRAPHQL_ADMIN_SECRET=change-me

# Where apply-metadata.sh reaches Hasura (the host-mapped port from compose).
HASURA_ENDPOINT=http://localhost:8080
