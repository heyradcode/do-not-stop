# Ethereum contract (required for production builds; CI/Vercel use placeholders if unset)
# v1 (deprecated, single contract)
VITE_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
# v2 contracts — default to the current Sepolia (chain 11155111) deployment if unset
VITE_PETCORE_ADDRESS=0x0BB0e03259Cf9DA7B0A3e258e2D17d68D7be9d33
VITE_GAMELOGIC_ADDRESS=0xaDEC55D3b9B2517D37C4bAbbb0dDc9F34de256ee
VITE_GAMECONFIG_ADDRESS=0xc8acCDc7D20B85326D586A7Fc861453E6550cCef
VITE_COMBATSIM_ADDRESS=0xca8Cb84D8e7619e783A2e546715BBe948E169C45

# Dynamic.xyz Configuration
VITE_DYNAMIC_ENVIRONMENT_ID=your-dynamic-environment-id-here
# Solana Configuration
VITE_SOLANA_LOCAL_RPC_URL=http://localhost:8899

# CryptoPets (Anchor on Solana) — cluster: devnet | mainnet-beta | localnet
VITE_SOLANA_CLUSTER=devnet
VITE_CRYPTOPETS_PROGRAM_ID=YOUR_CRYPTOPETS_PROGRAM_PUBKEY
VITE_CRYPTOPETS_IDL_ADDRESS=YOUR_ON_CHAIN_IDL_ACCOUNT_PUBKEY

# Backend API
VITE_API_URL=http://localhost:3001

# Pet art service (image-generator). Optional: leave unset and pets keep their
# emoji avatars. When set, each card requests its pet's generated art and falls
# back to the emoji while loading or if the image fails.
#
# Local dev: `pnpm dev:art` serves the service on :8787, and the value below is
# what talks to it. Point at the deployed service in production.
VITE_IMAGE_SERVICE_URL=http://localhost:8787
# VITE_IMAGE_SERVICE_URL=https://art.cryptopets.io
