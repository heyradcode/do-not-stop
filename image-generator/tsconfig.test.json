// Typechecks the specs too. tsconfig.json excludes them so they stay out of
// dist/, which meant nothing typechecked them at all: a spec could reference a
// field that no longer exists and only vitest's esbuild (which strips types
// without checking them) would ever see it.
{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": true,
        "types": ["node"],
        // Widened past ./src because digitPair.test.ts deliberately imports a
        // sibling package's port to check this service's copy against it. Nothing
        // is emitted from this config, so rootDir only has to be wide enough to
        // contain the program. The build config keeps ./src, so production code
        // still cannot reach outside the package.
        "rootDir": ".."
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "dist"]
}
