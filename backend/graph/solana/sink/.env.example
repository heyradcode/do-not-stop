# Copy to sink/.env and fill in. Used by run.sh, docker-compose.yml, apply-metadata.sh.

# substreams-sink-sql connection (psql:// scheme; schemaName is sink-only, not libpq).
SINK_DSN='psql://postgres:postgres@192.168.133.146:5432/cryptopets?schemaName=solana&sslmode=disable'

# Solana devnet Substreams provider (run.sh run only).
SUBSTREAMS_ENDPOINT=devnet.sol.streamingfast.io:443
SUBSTREAMS_API_TOKEN=

# Postgres Hasura reads from (postgresql:// scheme). Docker on Mac/VM → Windows host:
HASURA_GRAPHQL_DATABASE_URL=postgresql://postgres:postgres@192.168.133.146:5432/cryptopets

# Admin secret protecting the Hasura endpoint/console. The backend sends this
# as x-hasura-admin-secret (HASURA_ADMIN_SECRET in backend/.env).
HASURA_GRAPHQL_ADMIN_SECRET=change-me

# Where apply-metadata.sh reaches Hasura (the host-mapped port from compose).
HASURA_ENDPOINT=http://localhost:8080
