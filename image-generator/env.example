# Cloudflare Workers AI credentials.
# Account ID: Cloudflare dashboard -> Workers & Pages -> Overview (right sidebar).
# API token:  My Profile -> API Tokens -> Create Token, with the
#             "Workers AI" -> Read permission. Account-scoped, not zone-scoped.
CF_ACCOUNT_ID=
CF_API_TOKEN=

# Image model. Default is SDXL-Lightning: it accepts an explicit seed, so a
# pet's image can be re-derived from its DNA. @cf/black-forest-labs/flux-1-schnell
# also works (the client adjusts the request body for it).
# CF_IMAGE_MODEL=@cf/bytedance/stable-diffusion-xl-lightning

# Square output edge in px, diffusion steps, and request timeout.
# Fewer steps costs fewer neurons on the free allocation.
# CF_IMAGE_SIZE=1024
# CF_IMAGE_STEPS=8
# CF_TIMEOUT_MS=60000
