# indexer-go configuration. All settings are read from the environment.
# Connection settings are validated by the component that uses them, so the
# skeleton boots with none of them set.

# --- Solana adapter ---
SOLANA_WS_URL=wss://devnet.helius-rpc.com/?api-key=YOUR_KEY
SOLANA_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_KEY
SOLANA_PROGRAM_ID=

# --- EVM adapter (The Graph subgraph query endpoint) ---
EVM_SUBGRAPH_URL=
EVM_POLL_INTERVAL=15s

# --- Storage (same Postgres the backend's Prisma schema owns) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cryptopets

# --- Reconciliation full-scan safety net ---
RECONCILE_INTERVAL=10m

# --- Serving ---
GRPC_ADDR=localhost:50051
HEALTH_ADDR=localhost:8090

# --- Logging: text | json ---
LOG_FORMAT=text
