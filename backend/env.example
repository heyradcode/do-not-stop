JWT_SECRET=your-super-secret-jwt-key-here
PORT=3001

# PostgreSQL connection string used by Prisma.
# Local dev example (adjust user/password/db to your local install):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cryptopets?schema=public

# --- PvP roster indexer (Substreams + subgraph → pet_roster) ---
# Enable/disable the background indexer (default: true).
# INDEXER_ENABLED=true
# How often to re-sync from subgraph GraphQL, in ms (default: 30000).
# INDEXER_INTERVAL_MS=30000
#
# Deploy subgraphs from backend/graph/{evm,solana}/ (see package scripts).
# Set one or both URLs — each chain has its own Studio deployment.
# SUBGRAPH_URL_EVM=https://api.studio.thegraph.com/query/<id>/cryptopets-evm/<version>
# SUBGRAPH_URL_SOLANA=https://api.studio.thegraph.com/query/<id>/cryptopets-solana/<version>
# Legacy alias for SUBGRAPH_URL_EVM:
# SUBGRAPH_URL=https://api.studio.thegraph.com/query/<id>/cryptopets-evm/<version>

# Optional — restrict CORS in production (comma-separated origins).
# Leave unset to allow all origins (default for local dev).
# CORS_ORIGIN=https://your-frontend.onrender.com,https://your-domain.com
