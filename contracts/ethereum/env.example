# --- Sepolia testnet deployment ---
# Pick ONE RPC URL source. SEPOLIA_URL wins; otherwise INFURA_PROJECT_ID or
# ALCHEMY_API_KEY are composed into a URL; otherwise a public RPC is used.
SEPOLIA_URL=https://sepolia.infura.io/v3/YOUR_PROJECT_ID
# INFURA_PROJECT_ID=
# ALCHEMY_API_KEY=

# Deployer key (0x-prefixed). MUST hold Sepolia ETH for gas, and the matching
# address MUST be a consumer on your Chainlink VRF subscription.
PRIVATE_KEY=0xyour_private_key_here

# Alternative public RPCs (free, rate-limited):
# SEPOLIA_URL=https://ethereum-sepolia-rpc.publicnode.com
# SEPOLIA_URL=https://rpc.sepolia.org
# SEPOLIA_URL=https://sepolia.gateway.tenderly.co
