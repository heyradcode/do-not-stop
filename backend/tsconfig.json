{
    "compilerOptions": {
        "target": "ES2022",
        "module": "CommonJS",
        "moduleResolution": "node",
        "ignoreDeprecations": "5.0",
        "paths": {
            "@config/*": [
                "./src/config/*"
            ],
            "@routes/*": [
                "./src/routes/*"
            ],
            "@features/*": [
                "./src/features/*"
            ],
            "@middleware/*": [
                "./src/middleware/*"
            ],
            "@repositories/*": [
                "./src/repositories/*"
            ],
            "@grpc-client/*": [
                "./src/grpc/*"
            ],
            "@ws/*": [
                "./src/ws/*"
            ],
            "@utils": [
                "./src/utils/index.ts"
            ],
            "@typings/*": [
                "./src/types/*"
            ],
            "@generated/*": [
                "./src/generated/*"
            ],
            "@graphql": [
                "./src/graphql/index.ts"
            ]
        },
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "allowJs": true,
        "outDir": "./dist",
        // rootDir stays the backend root (not ./src) so emit keeps the dist/src/...
        // layout the "main"/"start" entry (dist/src/server.js) expects.
        "rootDir": "./",
        "strict": true,
        "noImplicitAny": true,
        "strictNullChecks": true,
        "strictFunctionTypes": true,
        "noImplicitReturns": true,
        "noFallthroughCasesInSwitch": true,
        "noUncheckedIndexedAccess": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noImplicitOverride": true,
        "exactOptionalPropertyTypes": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "noEmit": false
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist",
        // Vitest specs — run via esbuild, not part of the production build, so
        // they don't get emitted to dist/ or require vitest types at build time.
        "src/**/*.test.ts"
    ]
}