{
    "name": "ethereum",
    "version": "0.0.0",
    "private": true,
    "license": "SEE LICENSE IN ../LICENSE",
    "type": "module",
    "scripts": {
        "hh": "node scripts/hardhat.js",
        "compile:only": "pnpm hh compile --force",
        "compile": "pnpm compile:only",
        "test": "pnpm hh test",
        "node": "pnpm hh node --hostname 0.0.0.0",
        "deploy": "tsx scripts/deploy.ts",
        "deploy:sepolia": "tsx scripts/deploy.ts --network=sepolia",
        "deploy:base-sepolia": "tsx scripts/deploy.ts --network=base-sepolia",
        "verify": "tsx scripts/verify.ts",
        "verify:sepolia": "tsx scripts/verify.ts --network=sepolia",
        "verify:base-sepolia": "tsx scripts/verify.ts --network=base-sepolia",
        "deploy:status": "pnpm hh ignition status",
        "deploy:visualize": "pnpm hh ignition visualize ignition/modules/CryptoPetsV2Live.ts",
        "upgrade:game-logic": "tsx scripts/upgrade-game-logic.ts",
        "upgrade:game-logic:sepolia": "tsx scripts/upgrade-game-logic.ts --network=sepolia",
        "upgrade:game-logic:base-sepolia": "tsx scripts/upgrade-game-logic.ts --network=base-sepolia"
    },
    "devDependencies": {
        "@cryptopets/protocol": "workspace:*",
        "@nomicfoundation/hardhat-ignition": "^3.0.3",
        "@nomicfoundation/hardhat-toolbox-viem": "^5.0.0",
        "@nomicfoundation/hardhat-verify": "3.0.13",
        "@openzeppelin/contracts": "^5.4.0",
        "@openzeppelin/contracts-upgradeable": "4.7.3",
        "@types/node": "^22.18.6",
        "chai": "^4.4.1",
        "hardhat": "^3.2.0",
        "typescript": "~5.8.0",
        "viem": "^2.37.8"
    },
    "dependencies": {
        "@pythnetwork/entropy-sdk-solidity": "^2.2.1"
    }
}
