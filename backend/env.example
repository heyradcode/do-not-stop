JWT_SECRET=your-super-secret-jwt-key-here
PORT=3001

# PostgreSQL connection string used by Prisma.
# Local dev example (adjust user/password/db to your local install):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cryptopets?schema=public

# --- PvP roster indexer (populates pet_roster for opponent matchmaking) ---
# Enable/disable the background indexer (default: true).
# INDEXER_ENABLED=true
# How often to re-scan, in ms (default: 30000).
# INDEXER_INTERVAL_MS=30000
# EVM source — pick ONE:
#   a) Subgraph (preferred for testnet/mainnet). If set, it takes precedence
#      over the RPC poller below. See PVP_BATTLE.md §2.bis.
# SUBGRAPH_URL=https://api.studio.thegraph.com/query/<id>/cryptopets/<version>
#   b) RPC poller (default for local dev). EVM JSON-RPC endpoint + contract.
# EVM_RPC_URL=http://localhost:8545
# CryptoPets contract address. Same value injected into frontend as
# VITE_CONTRACT_ADDRESS on local deploy. The EVM indexer is skipped if neither
# SUBGRAPH_URL nor EVM_CONTRACT_ADDRESS is set.
# EVM_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Solana source — set SOLANA_PROGRAM_ID to enable. Requires the program AND its
# IDL deployed on the target cluster (`anchor idl init`). Skipped if unset.
# SOLANA_RPC_URL=http://localhost:8899
# SOLANA_PROGRAM_ID=78AXV46ks5oFoJHkukvbsfZTJixdj2MeStzuC6thiUry

# Optional — restrict CORS in production (comma-separated origins).
# Leave unset to allow all origins (default for local dev).
# CORS_ORIGIN=https://your-frontend.onrender.com,https://your-domain.com
