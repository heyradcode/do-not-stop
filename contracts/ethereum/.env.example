# =============================================================================
# Shared (required for any deployment)
# =============================================================================
# Deployer key (0x-prefixed). MUST hold native gas on the target chain, and the
# matching address MUST be a consumer on your Chainlink VRF subscription.
PRIVATE_KEY=0x...

# Etherscan v2 API key. One key works for every chain (etherscan.io / multichain).
# Required by `pnpm verify` / `pnpm verify:sepolia`.
ETHERSCAN_API_KEY=

# =============================================================================
# Per-network configuration
# =============================================================================
# Pattern, for each network in scripts/networks.ts:
#   <PREFIX>_RPC_URL                  required
#   <PREFIX>_VRF_SUBSCRIPTION_ID      required
#   <PREFIX>_VRF_COORDINATOR          required unless a default is baked into networks.ts
#   <PREFIX>_VRF_KEY_HASH             required unless a default is baked into networks.ts
#   <PREFIX>_VRF_NATIVE_PAYMENT       optional, default "false"
#
# Coordinator + gas-lane key hash for any chain:
#   https://docs.chain.link/vrf/v2-5/supported-networks

# --- Sepolia (defaults for coordinator + key hash are baked in) ---
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID
SEPOLIA_VRF_SUBSCRIPTION_ID=
# Optional overrides:
# SEPOLIA_VRF_COORDINATOR=0x9DdfaCa8183c41ad55329BdeeD9F6A8d53168B1B
# SEPOLIA_VRF_KEY_HASH=0x787d74caea10b2b357790d5b5247c2f63d1d91572a9846f780606e4d953677ae
# SEPOLIA_VRF_NATIVE_PAYMENT=false

# --- Polygon Amoy (testnet) ---
# POLYGON_AMOY_RPC_URL=
# POLYGON_AMOY_VRF_SUBSCRIPTION_ID=
# POLYGON_AMOY_VRF_COORDINATOR=
# POLYGON_AMOY_VRF_KEY_HASH=

# --- BSC Testnet ---
# BSC_TESTNET_RPC_URL=
# BSC_TESTNET_VRF_SUBSCRIPTION_ID=
# BSC_TESTNET_VRF_COORDINATOR=
# BSC_TESTNET_VRF_KEY_HASH=

# --- Avalanche Fuji ---
# AVALANCHE_FUJI_RPC_URL=
# AVALANCHE_FUJI_VRF_SUBSCRIPTION_ID=
# AVALANCHE_FUJI_VRF_COORDINATOR=
# AVALANCHE_FUJI_VRF_KEY_HASH=

# --- Arbitrum Sepolia ---
# ARBITRUM_SEPOLIA_RPC_URL=
# ARBITRUM_SEPOLIA_VRF_SUBSCRIPTION_ID=
# ARBITRUM_SEPOLIA_VRF_COORDINATOR=
# ARBITRUM_SEPOLIA_VRF_KEY_HASH=

# --- OP Sepolia ---
# OPTIMISM_SEPOLIA_RPC_URL=
# OPTIMISM_SEPOLIA_VRF_SUBSCRIPTION_ID=
# OPTIMISM_SEPOLIA_VRF_COORDINATOR=
# OPTIMISM_SEPOLIA_VRF_KEY_HASH=

# --- Base Sepolia (active — see active-networks.json) ---
BASE_SEPOLIA_RPC_URL=https://base-sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID
# Pyth Entropy V2 address — look up at https://docs.pyth.network/entropy/chainlist
BASE_SEPOLIA_ENTROPY_ADDRESS=0x...

# --- Mainnets (Ethereum / BSC / Polygon / Avalanche / Arbitrum / Optimism / Base) ---
# Same pattern, prefix is MAINNET / BSC / POLYGON / AVALANCHE / ARBITRUM / OPTIMISM / BASE.
# MAINNET_RPC_URL=
# MAINNET_VRF_SUBSCRIPTION_ID=
# MAINNET_VRF_COORDINATOR=
# MAINNET_VRF_KEY_HASH=
