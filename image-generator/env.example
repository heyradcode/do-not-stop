# ─── HTTP server ──────────────────────────────────────────────────────────────

# PORT=8787

# Absolute URL this service is reachable at. Metadata puts image URLs under it,
# so a wrong value here hands marketplaces links that 404. Defaults to
# http://localhost:$PORT, which is correct for dev and wrong for production.
# PUBLIC_BASE_URL=https://art.cryptopets.io

# How long an image request waits for generation before answering 503 with
# Retry-After. The generation is NOT cancelled: it finishes and lands in the
# store, so the retry is a cache hit and nothing paid for is wasted. Exists
# because a cold gallery asks for every pet at once and the last caller would
# otherwise hold a connection open for minutes.
# IMAGE_RESPONSE_TIMEOUT_MS=25000

# Optional per-pet game link included in metadata as external_url.
# EXTERNAL_URL_TEMPLATE=https://cryptopets.vercel.app/{chain}/pet/{tokenId}

# ─── Chain reads ──────────────────────────────────────────────────────────────

# The service reads PetCore directly rather than asking the backend: a stale
# roster read would not render a slightly outdated pet, it would render the
# wrong pet and cache that permanently.
EVM_RPC_URL=
PETCORE_ADDRESS=

# Solana is optional: set both or neither, or the service refuses to boot.
# Pets there are addressed by Metaplex Core asset pubkey, not a numeric id, so
# the route is /image/solana/<asset-pubkey>.png. The lookup uses
# getProgramAccounts, which some hosted providers disable.
# SOLANA_RPC_URL=https://api.devnet.solana.com
# SOLANA_PROGRAM_ID=

# ─── Cloudflare Workers AI ────────────────────────────────────────────────────

# Cloudflare Workers AI credentials.
# Account ID: Cloudflare dashboard -> Workers & Pages -> Overview (right sidebar).
# API token:  My Profile -> API Tokens -> Create Token, with the
#             "Workers AI" -> Read permission. Account-scoped, not zone-scoped.
CF_ACCOUNT_ID=
CF_API_TOKEN=

# Image model. Default is SDXL-Lightning: it accepts an explicit seed, so a
# pet's image can be re-derived from its DNA. @cf/black-forest-labs/flux-1-schnell
# also works, but takes no seed, so its output is only recoverable from cache.
# CF_IMAGE_MODEL=@cf/bytedance/stable-diffusion-xl-lightning

# Workers AI endpoint base. Override to point at a Cloudflare-compatible gateway,
# or at a fake endpoint to exercise the built server without credentials (this is
# how `pnpm smoke` works).
# CF_API_BASE=https://api.cloudflare.com/client/v4/accounts

# Square output edge in px, diffusion steps, and request timeout.
# Fewer steps costs fewer neurons on the free allocation.
# CF_IMAGE_SIZE=1024
# CF_IMAGE_STEPS=8
# CF_TIMEOUT_MS=60000

# Attempts per image, including the first. 429s and 5xx are retried with
# exponential backoff, honouring Retry-After; a 4xx is not, since the request
# itself is wrong. 1 disables retrying.
# CF_MAX_ATTEMPTS=3

# Simultaneous generations. A marketplace crawling a collection's images arrives
# as a burst, and without a bound that becomes N concurrent Workers AI calls that
# mostly come back rate-limited. Excess callers queue rather than fail.
# CF_MAX_CONCURRENT=2

# ─── Storage ──────────────────────────────────────────────────────────────────

# Where generated art is stored. Art must persist: a store that forgets means
# regenerating, and a regenerated pet does not look like the one its owner
# already has. Use r2 in production.
#   r2         Cloudflare R2 (recommended; same account as Workers AI)
#   filesystem local disk, dev only (instances do not share a disk)
#   memory     never persists; correct only for one-shot CLI runs and tests
IMAGE_STORE=r2

# filesystem store only.
# IMAGE_STORE_ROOT=./.art

# R2 credentials: dashboard -> R2 -> Manage API Tokens -> Create API Token,
# with Object Read & Write on the bucket below. These are R2-specific keys and
# are not the same thing as CF_API_TOKEN above.
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Defaults to CF_ACCOUNT_ID; set only if the bucket lives in another account.
# R2_ACCOUNT_ID=

# Public bucket or custom-domain base URL. Set this and NFT metadata can point
# image URLs straight at Cloudflare instead of routing bytes through this
# service.
# R2_PUBLIC_BASE_URL=https://art.example.com
